# Copy to .env and adjust for your deployment. Never commit real credentials.

# --- MongoDB (the only datastore) ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=retail_intelligence
MONGO_SERVER_SELECTION_TIMEOUT_MS=4000

# --- Runtime ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma separated list of browser origins allowed to call this API.
# Defaults to the Vite dev server used by the dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dashboard sign-in ---
# Change these before deploying beyond local development.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_ADMIN_EMAIL=manager@retail.ai
AUTH_ADMIN_PASSWORD=password123
AUTH_ADMIN_NAME=A. Krishnan
AUTH_ADMIN_ROLE=store_manager

# --- Deterministic alerting / recommendation thresholds ---
QUEUE_ALERT_THRESHOLD=5
PREDICTED_QUEUE_THRESHOLD=8
QUEUE_PREDICTION_MINUTES=5
SHELF_LOW_CONFIDENCE_THRESHOLD=0.5
